{
  "name": "window_2s_software_baseline",
  "description": "2.0-second 50% overlapping window configuration reproducing previous software baseline",
  "sampling": {
    "frequency_hz": 256,
    "adc_scale_lsb_per_uv": 20.0
  },
  "windowing": {
    "window_sec": 2.0,
    "hop_sec": 1.0,
    "window_samples": 512,
    "hop_samples": 256,
    "overlap_percent": 50.0,
    "label_overlap_threshold": 0.5
  },
  "channels": {
    "count": 22,
    "montage_type": "bipolar",
    "channel_list": [
      "FP1-F7", "F7-T7", "T7-P7", "P7-O1",
      "FP1-F3", "F3-C3", "C3-P3", "P3-O1",
      "FP2-F4", "F4-C4", "C4-P4", "P4-O2",
      "FP2-F8", "F8-T8", "T8-P8", "P8-O2",
      "FZ-CZ", "CZ-PZ", "P7-T7", "T7-FT9",
      "FT9-FT10", "FT10-T8"
    ]
  },
  "preprocessing": {
    "bandpass_low_hz": 0.5,
    "bandpass_high_hz": 25.0,
    "iir_order": 2,
    "filter_type": "butterworth"
  },
  "wavelet": {
    "name": "db4",
    "decomposition_level": 5,
    "retained_subbands": ["D3", "D4", "D5", "A5"],
    "subband_coeff_counts": {
      "D3": 64,
      "D4": 32,
      "D5": 16,
      "A5": 16
    }
  },
  "features": {
    "per_subband": ["energy", "line_length"],
    "total_features": 176,
    "feature_ordering": "channel_major_subband_major_feature_minor"
  },
  "hardware_fixedpoint": {
    "energy_shifts": {
      "D3": 21,
      "D4": 20,
      "D5": 19,
      "A5": 19
    },
    "linelength_shifts": {
      "D3": 6,
      "D4": 5,
      "D5": 4,
      "A5": 4
    },
    "feature_width": 16,
    "weight_width": 16,
    "bias_width": 32,
    "accumulator_width": 40
  },
  "classifier": {
    "type": "LinearSVC",
    "C": 1.0,
    "class_weight": "balanced",
    "max_iter": 20000,
    "random_seed": 42,
    "standardize": true,
    "standardize_on_train_only": true
  },
  "postprocess": {
    "k_persistence": 3,
    "refractory_sec": 30.0,
    "tolerance_sec": 2.0
  },
  "evaluation": {
    "protocol": "Leave-One-Record-Out",
    "subjects": ["chb01", "chb02", "chb03"]
  }
}
